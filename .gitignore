# dependencies & local stores
node_modules/
.pnpm-store/

# NOTE: lib/ is intentionally committed (not ignored): remote git installs via
# `dsh plugin --profile acp add <git-url>` need the prebuilt bundle, and we keep
# installs free of build scripts (pnpm 11 would demand an allowBuilds entry).
# Rebuild after each change and commit lib/ together with the source.

# npm tarballs
*.tgz

# local agent skills & skill registry lock
.agents/
skills-lock.json

# OS / editor junk
.DS_Store
*.log
